# MachineFit — copy to backend/.env and frontend/.env as needed

# Backend
NODE_ENV=development
PORT=3001
API_BASE_PATH=/api/v1

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/machinefit

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public API base (used for local-upload media URLs when Supabase Storage is unset)
# PUBLIC_API_BASE_URL=https://machinefit-api.onrender.com/api/v1

# Motivation audio uploads (bytes / max tracks / storage bucket)
MOTIVATION_AUDIO_MAX_BYTES=20971520
MOTIVATION_AUDIO_MAX_TRACKS=20
MOTIVATION_AUDIO_BUCKET=motivation-audio
MOTIVATION_COVER_IMAGE_BUCKET=motivation-covers

# Muscle group representative images (bytes / storage bucket)
MUSCLE_GROUP_IMAGE_MAX_BYTES=10485760
MUSCLE_GROUP_IMAGE_BUCKET=muscle-group-images

# Machine cover images (reuse max bytes; separate storage bucket)
MACHINE_COVER_IMAGE_BUCKET=machine-cover-images

# CORS
CORS_ORIGIN=http://localhost:5173,https://machine-fit.com,https://madbandi-star.github.io

# Email (Gmail 앱 비밀번호 또는 Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=MachineFit <your@gmail.com>
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=MachineFit <onboarding@resend.dev>
# FORMSUBMIT_ORIGIN=https://machine-fit.com
# FRONTEND_BASE_URL=https://machine-fit.com/machinefit
# Opt-in only. Unset/false = never send personal email content to FormSubmit.
# FORMSUBMIT_FALLBACK=true
# EMAIL_BROWSER_FALLBACK=true

# OAuth / social login (backend verification)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# KAKAO_REST_API_KEY=kakao-rest-api-key
# KAKAO_CLIENT_SECRET=kakao-client-secret-if-enabled
# APPLE_CLIENT_ID=com.example.machinefit.web

# Payment / Polar Premium (PWA web checkout only)
# PAYMENT_PROVIDER=dummy
# Dev-only: required header x-machinefit-webhook-secret for POST /webhook/dummy
# DUMMY_WEBHOOK_SECRET=local-dev-webhook-secret
# PAYMENT_PROVIDER=polar
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_ORGANIZATION_ID=
# POLAR_PREMIUM_PRODUCT_ID=
# POLAR_SERVER=production
# POLAR_SUCCESS_URL=https://machine-fit.com/machinefit/my-page?billing=success
# POLAR_RETURN_URL=https://machine-fit.com/machinefit/my-page?billing=cancel
# FRONTEND_BASE_URL=https://machine-fit.com/machinefit

# Frontend
VITE_API_BASE_URL=http://localhost:3001/api/v1
# Optional override for share / invite marketing URL (default: https://machine-fit.com + Vite base)
# VITE_PUBLIC_SITE_URL=https://machine-fit.com/machinefit/
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# VITE_KAKAO_JS_KEY=kakao-javascript-key
# VITE_APPLE_CLIENT_ID=com.example.machinefit.web
# VITE_APPLE_REDIRECT_URI=https://your-frontend-origin/

# Sentry (optional — free Developer plan). Leave unset to disable.
# Backend (Render):
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# Frontend (GitHub Actions secret VITE_SENTRY_DSN + build-time):
# VITE_SENTRY_DSN=https://yyyy@o0.ingest.sentry.io/0
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
# VITE_SENTRY_ENABLE_DEV=true
# Optional source maps upload (GitHub Secrets):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
